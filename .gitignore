# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed data can be large; keep small sample data tracked, ignore full downloads if needed)
data/raw/*.cache
data/processed/*.tmp

# Models. The preprocessor + TabPFN bundles are committed on purpose (the
# "pre-train + bundle" deploy flow ships them to the Hugging Face Space), with
# the big TabPFN bundles tracked via Git LFS — see .gitattributes.
models/*.pkl
!models/*.joblib
!models/.gitkeep

# TabPFN's downloaded pretrained weights (cached at runtime, never committed).
.tabpfn_models/

# Reports (generated per-run PDF reports, prediction history DB)
reports/generated/*.pdf
reports/generated/*.html
!reports/generated/.gitkeep
reports/prediction_history.db

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# TabPFN local cache
.tabpfn/

# Paper working folder: saved third-party paper texts must never be committed
paper-draft/sources/
paper-draft/results_dryrun/
